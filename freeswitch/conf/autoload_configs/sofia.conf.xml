<configuration name="sofia.conf" description="Sofia SIP">
  <global_settings>
    <param name="log-level" value="0"/>
    <param name="auto-restart" value="false"/>
    <param name="debug-presence" value="0"/>
  </global_settings>

  <profiles>
    <!-- Internal profile: WebRTC agents (WSS) + local SIP softphones -->
    <profile name="internal">
      <aliases/>
      <gateways/>
      <domains>
        <domain name="all" alias="true" parse="true"/>
      </domains>
      <settings>
        <param name="debug" value="0"/>
        <param name="sip-ip" value="$${local_ip_v4}"/>
        <param name="sip-port" value="5060"/>
        <param name="tls-sip-port" value="5061"/>
        <param name="tls" value="true"/>
        <param name="tls-only" value="false"/>
        <param name="tls-cert-dir" value="/etc/freeswitch/tls"/>

        <!-- WebSocket / WebRTC -->
        <param name="ws-binding" value=":5066"/>
        <param name="wss-binding" value="$${wss_binding}"/>

        <!-- SRTP for WebRTC -->
        <param name="inbound-late-negotiation" value="true"/>
        <param name="inbound-zrtp-passthru" value="false"/>
        <param name="manage-presence" value="true"/>
        <param name="presence-hosts" value="$${domain}"/>

        <param name="codec-prefs" value="$${global_codec_prefs}"/>
        <param name="rtp-timer-name" value="soft"/>
        <param name="rtp-ip" value="$${local_ip_v4}"/>
        <param name="ext-rtp-ip" value="auto-nat"/>
        <param name="ext-sip-ip" value="auto-nat"/>
        <param name="rtp-timeout-sec" value="300"/>
        <param name="rtp-hold-timeout-sec" value="1800"/>

        <param name="auth-calls" value="true"/>
        <param name="inbound-reg-force-matching-username" value="true"/>
        <param name="nonce-ttl" value="60"/>
        <param name="dtmf-duration" value="2000"/>
        <param name="enable-timer" value="false"/>
        <param name="dtmf-type" value="rfc2833"/>

        <param name="record-path" value="/var/lib/freeswitch/recordings"/>
        <param name="record-template" value="${caller_id_number}.${target_domain}.${strftime(%Y-%m-%d-%H-%M-%S)}.wav"/>

        <!-- STUN for WebRTC NAT traversal -->
        <param name="stun-enabled" value="true"/>
        <param name="stun-auto-disable" value="true"/>
        <param name="aggressive-nat-detection" value="true"/>
      </settings>
    </profile>

    <!-- External profile: SIP trunk to PSTN -->
    <profile name="external">
      <gateways>
        <X-PRE-PROCESS cmd="include" data="../sip_profiles/external_gateways/*.xml"/>
      </gateways>
      <domains>
        <domain name="all" alias="false" parse="false"/>
      </domains>
      <settings>
        <param name="debug" value="0"/>
        <param name="sip-ip" value="$${local_ip_v4}"/>
        <param name="sip-port" value="5080"/>
        <param name="rtp-ip" value="$${local_ip_v4}"/>
        <param name="ext-rtp-ip" value="auto-nat"/>
        <param name="ext-sip-ip" value="auto-nat"/>
        <param name="codec-prefs" value="$${outbound_codec_prefs}"/>
        <param name="dtmf-duration" value="2000"/>
        <param name="dtmf-type" value="rfc2833"/>
        <param name="inbound-codec-negotiation" value="generous"/>
        <param name="auth-calls" value="false"/>
        <param name="nonce-ttl" value="60"/>
        <param name="rtp-timeout-sec" value="300"/>
        <param name="enable-timer" value="false"/>
      </settings>
    </profile>
  </profiles>
</configuration>
