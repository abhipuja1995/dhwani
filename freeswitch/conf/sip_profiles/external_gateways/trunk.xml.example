<!-- Rename to trunk.xml and fill in your SIP trunk credentials -->
<gateway name="pstn_trunk">
  <param name="realm" value="YOUR_TRUNK_HOST"/>
  <param name="username" value="YOUR_TRUNK_USERNAME"/>
  <param name="password" value="YOUR_TRUNK_PASSWORD"/>
  <param name="from-user" value="YOUR_CALLER_ID_NUMBER"/>
  <param name="from-domain" value="YOUR_TRUNK_HOST"/>
  <param name="proxy" value="YOUR_TRUNK_HOST"/>
  <param name="register" value="true"/>
  <param name="caller-id-in-from" value="false"/>
  <param name="contact-params" value="tport=udp"/>
  <param name="retry-seconds" value="30"/>
  <param name="ping" value="25"/>
  <param name="codec-prefs" value="PCMU,PCMA"/>
</gateway>
